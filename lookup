SELECT DISTINCT TABLE_SCHEMA AS TableSchema,
                TABLE_NAME AS TableName
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'dbo'
AND TABLE_TYPE = 'BASE TABLE'
AND TABLE_NAME NOT IN (
    'V_ACCOUNT_SUMMARY_AAV2',
    'V_T_F_ACCT_TXN_AAV2',
    'V_T_F_ACCOUNT_SNAPSHOT_AAV2'
)
ORDER BY TABLE_NAME
